{
  "name": "prism-player",
  "version": "2.1.0",
  "description": "Prism Player",
  "main": "electron/main.js",
  "author": "Prism",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/dev.js",
    "test": "node --test --test-force-exit test/server.test.js test/color.test.mjs test/appearance.test.mjs test/looks.test.mjs test/logic.test.mjs test/dsp.test.mjs test/folders.test.js test/audio.test.js test/lyrics.test.js test/lyrics2.test.js test/settingsio.test.js test/lyrics-ui.test.mjs test/recap.test.js test/recapviews.test.mjs test/hotkeys.test.mjs test/cache.test.js test/electron.test.js test/cue.test.js test/mix.test.js test/lfstats.test.js test/dj.test.mjs test/vizlayout.test.mjs test/speed.test.js test/tags.test.js test/covers.test.js test/art.test.js test/features21.test.js",
    "dist": "electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.prism.player",
    "productName": "Prism Player",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "src/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "ffmpeg.exe",
          "ffprobe.exe"
        ]
      },
      {
        "from": "vendor/prism-audio",
        "to": "prism-audio",
        "filter": [
          "prism-audio.exe"
        ]
      },
      {
        "from": "build",
        "to": "icon",
        "filter": [
          "icon.png",
          "icon.ico"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "installerIcon": "build/installer.ico",
      "uninstallerIcon": "build/installer.ico"
    },
    "portable": {
      "artifactName": "Prism-portable-${version}.exe"
    },
    "artifactName": "Prism-Setup-${version}.${ext}"
  }
}
